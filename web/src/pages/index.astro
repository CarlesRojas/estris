---
import "../styles/spot.css";
import "../styles/site.css";
import { features } from "../data/features";
import { spots } from "../components/spots";
import { DOWNLOAD_URL, MIN_MACOS } from "../config";

const description = "Ten small utilities for your Mac in one menu bar app: window snapping, clipboard history, a volume mixer and more. Free.";
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Estris · The little tools your Mac is missing</title>
    <meta name="description" content={description} />
    <meta property="og:title" content="Estris" />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#f5f5f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="top">
      <a class="brand" href="/" aria-label="Estris">
        <img src="/icon.svg" alt="" width="34" height="34" />
        <span>Estris</span>
      </a>
    </header>

    <main class="showcase">
      <div class="hero">
        <img src="/icon.svg" alt="" width="72" height="72" />
        <h1>The little tools your Mac is missing.</h1>
        <a class="button button-large" href={DOWNLOAD_URL}><svg class="button-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3v9.5M5.5 8.5 10 13l4.5-4.5M4 16.5h12" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg>Download for Mac</a>
      </div>
      <nav class="feature-list" role="tablist" aria-label="Features">
        {features.map((feature, index) => (
          <button
            class="feature-tab"
            role="tab"
            id={`tab-${feature.id}`}
            aria-controls={`panel-${feature.id}`}
            aria-selected={index === 0 ? "true" : "false"}
            tabindex={index === 0 ? 0 : -1}
            style={`--seconds:${feature.seconds}s;--accent:${feature.accent}`}
          >
            <span class="tab-label">
              <svg class="tab-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={feature.icon} />
              <span class="tab-name">{feature.title}</span>
            </span>
            <span class="progress" aria-hidden="true"><i></i></span>
          </button>
        ))}
      </nav>

      <div class="stage">
        {features.map((feature, index) => {
          const Spot = spots[feature.id];
          return (
            <article
              class="feature-panel"
              role="tabpanel"
              id={`panel-${feature.id}`}
              aria-labelledby={`tab-${feature.id}`}
              data-seconds={feature.seconds}
              style={`--accent:${feature.accent}`}
              hidden={index !== 0}
            >
              <div class="spot-frame" aria-hidden="true"><Spot d={feature.seconds} /></div>
              <div class="copy">
                <h2>{feature.title}</h2>
                <p class="tagline">{feature.tagline}</p>
                <p class="details">{feature.details}</p>
              </div>
            </article>
          );
        })}
      </div>
    </main>

    <footer class="foot">
      <div class="foot-cta">
        <img src="/icon.svg" alt="" width="40" height="40" />
        <p class="foot-title">All ten tools, free.</p>
        <a class="button" href={DOWNLOAD_URL}><svg class="button-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3v9.5M5.5 8.5 10 13l4.5-4.5M4 16.5h12" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg>Download for Mac</a>
        <p class="note">{MIN_MACOS}</p>
      </div>
      <p class="copyright">© {year} Carles Rojas</p>
    </footer>

    <script>
      // The features play one after another, each for its animation's length. Picking one
      // stops that: it keeps replaying until another is picked.
      const tabs = [...document.querySelectorAll<HTMLButtonElement>(".feature-tab")];
      const panels = [...document.querySelectorAll<HTMLElement>(".feature-panel")];
      let current = 0;
      let picked = false;
      let timer: number | undefined;
      let visible = false;

      function play(index: number) {
        current = index;
        tabs.forEach((tab, i) => {
          const active = i === index;
          tab.setAttribute("aria-selected", String(active));
          tab.tabIndex = active ? 0 : -1;
          tab.classList.remove("running");
        });
        panels.forEach((panel, i) => (panel.hidden = i !== index));
        const panel = panels[index];
        const spot = panel.querySelector<HTMLElement>(".spot");
        // Restart its animations, and the tab's progress bar.
        spot?.classList.remove("playing");
        void spot?.offsetWidth;
        spot?.classList.add("playing");
        // On narrow screens the list scrolls sideways: keep the playing one in view.
        const list = tabs[index].parentElement!;
        if (list.scrollWidth > list.clientWidth) list.scrollTo({ left: tabs[index].offsetLeft - 16, behavior: "smooth" });
        void tabs[index].offsetWidth;
        tabs[index].classList.toggle("running", !picked);
        window.clearTimeout(timer);
        if (!visible) return;
        const seconds = Number(panel.dataset.seconds) || 7;
        // Each animation ends as it starts, so replaying one is seamless.
        timer = window.setTimeout(() => play(picked ? current : (current + 1) % panels.length), seconds * 1000);
      }

      tabs.forEach((tab, index) =>
        tab.addEventListener("click", () => {
          picked = true;
          play(index);
        }),
      );

      // Arrow keys move between tabs, as in any tab list.
      document.querySelector(".feature-list")?.addEventListener("keydown", (event) => {
        const key = (event as KeyboardEvent).key;
        const step = key === "ArrowDown" || key === "ArrowRight" ? 1 : key === "ArrowUp" || key === "ArrowLeft" ? -1 : 0;
        if (!step) return;
        event.preventDefault();
        picked = true;
        const next = (current + step + tabs.length) % tabs.length;
        play(next);
        tabs[next].focus();
      });

      // Back in front after being in the background: carry on from where it was.
      document.addEventListener("visibilitychange", () => {
        if (document.visibilityState === "visible" && visible) play(current);
      });

      // The stage's corners follow the animation's screen, so both curves are concentric:
      // its radius is the screen's (2.6% of the animation) plus the gap above the screen.
      const stage = document.querySelector<HTMLElement>(".stage")!;
      function fitCorners() {
        const panel = panels.find((p) => !p.hidden) ?? panels[0];
        const spot = panel.querySelector<HTMLElement>(".spot");
        const screen = panel.querySelector<HTMLElement>(".screen");
        if (!spot || !screen) return;
        const gap = screen.getBoundingClientRect().top - stage.getBoundingClientRect().top;
        stage.style.setProperty("--radius", `${Math.round(gap + spot.offsetWidth * 0.026)}px`);
      }
      new ResizeObserver(fitCorners).observe(stage);

      // The feature pills wrap into rows as even as they can be: the narrowest list that keeps
      // the same number of rows (as text-wrap: balance does for words).
      const list = document.querySelector<HTMLElement>(".feature-list")!;
      const rowCount = () => new Set(tabs.map((tab) => tab.offsetTop)).size;
      function balanceRows() {
        list.style.maxWidth = "";
        if (getComputedStyle(list).display !== "flex") return;
        const rows = rowCount();
        if (rows < 2) return;
        let low = 0;
        let high = list.offsetWidth;
        while (high - low > 1) {
          const middle = Math.floor((low + high) / 2);
          list.style.maxWidth = `${middle}px`;
          if (rowCount() > rows) low = middle;
          else high = middle;
        }
        list.style.maxWidth = `${high}px`;
      }
      balanceRows();
      document.fonts?.ready.then(balanceRows);
      let lastWidth = window.innerWidth;
      window.addEventListener("resize", () => {
        if (window.innerWidth !== lastWidth) {
          lastWidth = window.innerWidth;
          balanceRows();
        }
      });

      // Only plays while on screen.
      new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
        if (visible) play(current);
        else window.clearTimeout(timer);
      }, { threshold: 0.25 }).observe(document.querySelector(".stage")!);
    </script>
  </body>
</html>
