---
import Cursor from "../Cursor.astro";
import { pointer, presses, pop, EASE } from "../../lib/motion";
/** A square-cornered window filling a square-cornered screen below the menu bar. A click on
    Rounded Corners' switch rounds the screen's corners off in black, as round as the menu bar is
    tall; a second click squares them up again, so it loops. */
const { d } = Astro.props;
// The switch is at (70.5%, 55%) of the screen.
const css = [
  pointer("rc-cursor", [[0, 82, 82], [6, 82, 82], [15, 70.5, 56], [72, 70.5, 56], [88, 82, 82], [100, 82, 82]]),
  presses("rc-press", [17, 74]),
  pop("rc-pill", 28, 70),
  `@keyframes rc-corners {
    0%, 19.5% { border-radius: 0; animation-timing-function: ${EASE.snap}; }
    30%, 75.5% { border-radius: var(--r); animation-timing-function: ${EASE.snap}; }
    84%, 100% { border-radius: 0; }
  }`,
  `@keyframes rc-switch {
    0%, 18% { background: rgba(255, 255, 255, .2); }
    20%, 75% { background: var(--green); }
    77%, 100% { background: rgba(255, 255, 255, .2); }
  }`,
  `@keyframes rc-knob {
    0%, 18% { transform: none; animation-timing-function: ${EASE.back}; }
    22%, 75% { transform: translateX(3.6cqw); animation-timing-function: ${EASE.back}; }
    79%, 100% { transform: none; }
  }`,
].join("\n");
---
<div class="spot s-rc" style={`--d:${d}s`}>
  <div class="screen rc-screen">
    <div class="rc-menubar">
      <span class="rc-menus"><i></i><b></b><b></b><b></b></span>
      <span class="rc-status"><b></b><b></b></span>
    </div>
    <div class="win rc-win">
      <div class="bar"><i></i><i></i><i></i></div>
      <div class="rc-lines"><b></b><b></b></div>
      <div class="rc-card">
        <span class="rc-tile">
          <svg viewBox="0 0 24 24"><path d="M3.5 9.5V7.5a4 4 0 0 1 4-4h2M14.5 3.5h2a4 4 0 0 1 4 4v2M20.5 14.5v2a4 4 0 0 1-4 4h-2M9.5 20.5h-2a4 4 0 0 1-4-4v-2" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
        </span>
        <span class="rc-name">Rounded Corners</span>
        <span class="rc-switch"><i></i></span>
      </div>
    </div>
    <div class="rc-corners"></div>
    <Cursor class="rc-cursor" />
  </div>
  <div class="rc-pill"><span class="pill">Rounded corners · On</span></div>
</div>

<style is:global>
  /* --r is the screen's corner radius once on: the menu bar's height. */
  .s-rc { --menubar: 4cqw; --r: var(--menubar); }
  /* Square corners, as most displays have. */
  .s-rc .rc-screen { border-radius: 0.4cqw; }
  /* Menus and status items kept clear of the corners. */
  .s-rc .rc-menubar {
    position: absolute; left: 0; right: 0; top: 0; height: var(--menubar); display: flex; align-items: center; justify-content: space-between;
    padding: 0 calc(var(--r) + 1.4cqw); background: rgba(30, 32, 44, .9);
  }
  .s-rc .rc-menus, .s-rc .rc-status { display: flex; align-items: center; gap: 1.6cqw; }
  .s-rc .rc-menubar i { width: 1.6cqw; height: 1.6cqw; border-radius: 50%; background: rgba(255, 255, 255, .85); }
  .s-rc .rc-menubar b { width: 4.5cqw; height: 1cqw; border-radius: 1cqw; background: rgba(255, 255, 255, .45); }
  .s-rc .rc-status b { width: 2.6cqw; }
  /* Fills the screen under the menu bar, as a zoomed window does. */
  .s-rc .rc-win {
    left: 0; right: 0; top: var(--menubar); bottom: 0; border-radius: 0; box-shadow: none; background: #26272d;
  }
  .s-rc .rc-win .bar { height: 4cqw; padding-left: 2cqw; gap: 0.8cqw; }
  .s-rc .rc-win .bar i { width: 1.3cqw; height: 1.3cqw; }
  .s-rc .rc-lines { position: absolute; left: 12%; right: 12%; top: 18%; display: flex; flex-direction: column; gap: 1.4cqw; }
  .s-rc .rc-lines b { display: block; height: 1.3cqw; border-radius: 1cqw; background: rgba(255, 255, 255, .12); }
  .s-rc .rc-lines b:first-child { width: 45%; background: #4fd1c5; }
  .s-rc .rc-lines b:last-child { width: 70%; }
  .s-rc .rc-card {
    position: absolute; left: 50%; top: 54%; transform: translate(-50%, -50%); display: flex; align-items: center; gap: 2.2cqw;
    padding: 2.4cqw; border-radius: 2.6cqw; background: rgba(255, 255, 255, .06);
    box-shadow: 0 0 0 0.25cqw rgba(255, 255, 255, .1);
  }
  .s-rc .rc-tile { flex: none; width: 6.4cqw; height: 6.4cqw; border-radius: 1.6cqw; background: #4fd1c5; color: #fff; display: grid; place-items: center; }
  .s-rc .rc-tile svg { width: 64%; height: 64%; }
  .s-rc .rc-name { flex: none; margin-right: 1.6cqw; font-size: 3.4cqw; font-weight: 700; white-space: nowrap; }
  .s-rc .rc-switch { position: relative; flex: none; width: 8cqw; height: 4.4cqw; border-radius: 3cqw; background: rgba(255, 255, 255, .2); }
  .s-rc .rc-switch i { position: absolute; left: 0.4cqw; top: 0.4cqw; width: 3.6cqw; height: 3.6cqw; border-radius: 50%; background: #fff; box-shadow: 0 0.2cqw 0.5cqw rgba(0, 0, 0, .3); }
  /* Paints everything outside its rounded outline black, as the utility does. */
  .s-rc .rc-corners { position: absolute; inset: 0; border-radius: 0; box-shadow: 0 0 0 30cqw #000; z-index: 40; pointer-events: none; }
  .s-rc .rc-cursor { left: 82%; top: 82%; }
  .s-rc .rc-pill { position: absolute; left: 0; right: 0; top: 79%; display: flex; justify-content: center; opacity: 0; }
  .s-rc .rc-pill .pill { font-size: 3.4cqw; padding: 1.6cqw 3cqw; }

  .s-rc.playing .rc-cursor { animation: rc-cursor-x var(--d) both, rc-cursor-y var(--d) both; }
  .s-rc.playing .rc-cursor .press { animation: rc-press var(--d) both; }
  .s-rc.playing .rc-corners { animation: rc-corners var(--d) both; }
  .s-rc.playing .rc-switch { animation: rc-switch var(--d) both; }
  .s-rc.playing .rc-switch i { animation: rc-knob var(--d) both; }
  .s-rc.playing .rc-pill { animation: rc-pill var(--d) both; }
</style>
<Fragment set:html={`<style>${css}</style>`} />
