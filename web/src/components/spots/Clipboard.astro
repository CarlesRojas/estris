---
import Cursor from "../Cursor.astro";
import { pointer, presses, keyPresses, pop } from "../../lib/motion";
/** Selecting and copying a text, a link and an image in one window; then ⌘⇧V in another,
    stepping to the link and letting go to paste it. Ends as it starts. */
const { d } = Astro.props;
const css = [
  pointer("clip-cursor", [[0, 75, 85], [3, 75, 85], [7, 7, 24.8], [8, 7, 24.8], [13, 40, 24.8], [18, 7, 39.9], [19, 7, 39.9], [23.5, 30, 39.9], [29, 26, 64], [32, 26, 64], [39, 57.3, 24.8], [86, 57.3, 24.8], [96, 75, 85], [100, 75, 85]]),
  presses("clip-press", [30, 40], [[8, 13], [19, 23.5]]),
  pop("clip-keys-c", 11, 36),
  keyPresses("clip-c", [14.5, 25, 32.5]),
  pop("clip-keys-v", 43, 66),
  keyPresses("clip-v", [46, 56]),
  pop("clip-card", 47, 65, 0.8),
  pop("clip-pasted", 66, 86, 0.7),
].join("\n");
---
<div class="spot s-clip" style={`--d:${d}s`}>
  <div class="screen">
    <div class="win clip-source">
      <div class="bar"><i></i><i></i><i></i></div>
      <div class="clip-item clip-i1"><span class="clip-sel"></span><span class="clip-text">Meeting at 5 pm</span></div>
      <div class="clip-item clip-i2"><span class="clip-sel"></span><span class="clip-text link">estris.app</span></div>
      <div class="clip-item clip-i3"><span class="clip-sel"></span><span class="clip-img"></span></div>
    </div>
    <div class="win clip-doc">
      <div class="bar"><i></i><i></i><i></i></div>
      <div class="clip-slot"><span class="clip-caret"></span><span class="clip-pasted link">estris.app</span></div>
      <div class="clip-lines"><b></b><b></b><b></b></div>
    </div>
    <div class="clip-card">
      <div class="clip-e clip-e1"><span class="clip-img big"></span></div>
      <div class="clip-e clip-e2"><span class="link">estris.app</span></div>
      <div class="clip-n clip-n1 pill">1 of 3</div>
      <div class="clip-n clip-n2 pill">2 of 3</div>
    </div>
    <Cursor class="clip-cursor" />
  </div>
  <div class="keys clip-keys-c"><span class="key">⌘</span><span class="key clip-c">C</span></div>
  <div class="keys clip-keys-v"><span class="key">⌘</span><span class="key">⇧</span><span class="key clip-v">V</span></div>
</div>
<Fragment set:html={`<style>${css}</style>`} />

<style is:global>
  .s-clip .clip-source { left: 4%; top: 8%; width: 44%; height: 84%; }
  .s-clip .clip-doc { left: 52%; top: 8%; width: 44%; height: 84%; }
  .s-clip .clip-item { position: absolute; left: 6%; right: 6%; display: flex; align-items: center; }
  .s-clip .clip-i1 { top: 14%; height: 12%; }
  .s-clip .clip-i2 { top: 32%; height: 12%; }
  .s-clip .clip-i3 { top: 50%; height: 34%; }
  .s-clip .clip-sel { position: absolute; inset: 0; border-radius: 0.8cqw; background: rgba(110, 168, 254, 0.42); transform-origin: left; transform: scaleX(0); }
  .s-clip .clip-text { position: relative; padding-left: 1.4cqw; font-size: 3cqw; font-weight: 500; white-space: nowrap; }
  .s-clip .link { color: #9cc3ff; text-decoration: underline; }
  .s-clip .clip-img { position: relative; display: block; width: 100%; height: 100%; border-radius: 1cqw; background: linear-gradient(135deg, var(--orange), var(--pink) 55%, var(--purple)); }
  .s-clip .clip-i3 .clip-sel { inset: -0.8cqw; transform: none; opacity: 0; background: none; box-shadow: 0 0 0 0.6cqw var(--blue); border-radius: 1.6cqw; }
  .s-clip .clip-img.big { width: 36cqw; height: 20cqw; border-radius: 1.4cqw; }
  .s-clip .clip-slot { position: absolute; left: 8%; right: 8%; top: 14%; height: 12%; display: flex; align-items: center; font-size: 3cqw; font-weight: 500; }
  .s-clip .clip-caret { width: 0.35cqw; height: 4cqw; background: #f5f5f7; opacity: 0; }
  .s-clip .clip-pasted { opacity: 0; margin-left: 0.4cqw; transform-origin: left center; }
  .s-clip .clip-lines { position: absolute; left: 8%; right: 8%; top: 34%; display: flex; flex-direction: column; gap: 1.6cqw; }
  .s-clip .clip-lines b { display: block; height: 1.2cqw; border-radius: 1cqw; background: rgba(255, 255, 255, 0.14); }
  .s-clip .clip-lines b:nth-child(2) { width: 80%; }
  .s-clip .clip-lines b:nth-child(3) { width: 60%; }
  .s-clip .clip-card {
    position: absolute; left: 16%; top: 20%; width: 68%; height: 56%; border-radius: 2.4cqw; z-index: 30;
    background: rgba(60, 61, 70, 0.9); backdrop-filter: blur(2cqw);
    box-shadow: 0 0 0 0.25cqw rgba(255, 255, 255, 0.16), 0 3cqw 6cqw rgba(0, 0, 0, .5);
    opacity: 0;
  }
  .s-clip .clip-e { position: absolute; inset: 0 0 18% 0; display: flex; align-items: center; justify-content: center; font-size: 4.6cqw; font-weight: 600; opacity: 0; }
  .s-clip .clip-n { position: absolute; left: 0; right: 0; bottom: 6%; margin: 0 auto; width: max-content; opacity: 0; }
  .s-clip .clip-cursor { left: 75%; top: 85%; }
  .s-clip .keys { opacity: 0; }

  .s-clip.playing .clip-cursor { animation: clip-cursor-x var(--d) both, clip-cursor-y var(--d) both; }
  .s-clip.playing .clip-cursor .press { animation: clip-press var(--d) both; }
  .s-clip.playing .clip-i1 .clip-sel { animation: clip-sel1 var(--d) both; }
  .s-clip.playing .clip-i2 .clip-sel { animation: clip-sel2 var(--d) both; }
  .s-clip.playing .clip-i3 .clip-sel { animation: clip-sel3 var(--d) both; }
  .s-clip.playing .clip-caret { animation: clip-caret var(--d) step-end both; }
  .s-clip.playing .clip-pasted { animation: clip-pasted var(--d) both; }
  .s-clip.playing .clip-card { animation: clip-card var(--d) both; }
  .s-clip.playing .clip-e1, .s-clip.playing .clip-n1 { animation: clip-s1 var(--d) both; }
  .s-clip.playing .clip-e2, .s-clip.playing .clip-n2 { animation: clip-s2 var(--d) both; }
  .s-clip.playing .clip-keys-c { animation: clip-keys-c var(--d) both; }
  .s-clip.playing .clip-c { animation: clip-c var(--d) both; }
  .s-clip.playing .clip-keys-v { animation: clip-keys-v var(--d) both; }
  .s-clip.playing .clip-v { animation: clip-v var(--d) both; }

  /* The selection follows the pointer as it drags across. */
  @keyframes clip-sel1 {
    0%, 8% { transform: scaleX(0); opacity: 1; animation-timing-function: cubic-bezier(.3, 0, .1, 1); }
    13%, 18% { transform: scaleX(1); opacity: 1; }
    20%, 100% { transform: scaleX(1); opacity: 0; }
  }
  @keyframes clip-sel2 {
    0%, 19% { transform: scaleX(0); opacity: 1; animation-timing-function: cubic-bezier(.3, 0, .1, 1); }
    23.5%, 29% { transform: scaleX(1); opacity: 1; }
    31%, 100% { transform: scaleX(1); opacity: 0; }
  }
  @keyframes clip-sel3 {
    0%, 30.6% { opacity: 0; transform: scale(.9); animation-timing-function: cubic-bezier(.34, 1.56, .64, 1); }
    33%, 38% { opacity: 1; transform: none; }
    40%, 100% { opacity: 0; transform: none; }
  }
  @keyframes clip-caret { 0% { opacity: 0; } 41% { opacity: 1; } 45% { opacity: 0; } 49% { opacity: 1; } 53% { opacity: 0; } 57% { opacity: 1; } 61% { opacity: 0; } 100% { opacity: 0; } }
  /* The card swaps entries with a small bounce. */
  @keyframes clip-s1 { 0%, 47% { opacity: 0; } 48%, 56% { opacity: 1; } 57%, 100% { opacity: 0; } }
  @keyframes clip-s2 {
    0%, 56.6% { opacity: 0; transform: scale(.88); animation-timing-function: cubic-bezier(.34, 1.56, .64, 1); }
    59%, 100% { opacity: 1; transform: none; }
  }
</style>
