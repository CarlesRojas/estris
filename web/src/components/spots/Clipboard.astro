---
import Cursor from "../Cursor.astro";
/** Selecting and copying a text, a link and an image in one window; then ⌘⇧V in another,
    stepping to the link and letting go to paste it. Ends as it starts. */
const { d } = Astro.props;
---
<div class="spot s-clip" style={`--d:${d}s`}>
  <div class="screen">
    <div class="win clip-source">
      <div class="bar"><i></i><i></i><i></i></div>
      <div class="clip-item clip-i1"><span class="clip-sel"></span><span class="clip-text">Meeting at 5 pm</span></div>
      <div class="clip-item clip-i2"><span class="clip-sel"></span><span class="clip-text link">estris.app</span></div>
      <div class="clip-item clip-i3"><span class="clip-sel"></span><span class="clip-img"></span></div>
    </div>
    <div class="win clip-doc">
      <div class="bar"><i></i><i></i><i></i></div>
      <div class="clip-slot"><span class="clip-caret"></span><span class="clip-pasted link">estris.app</span></div>
      <div class="clip-lines"><b></b><b></b><b></b></div>
    </div>
    <div class="clip-card">
      <div class="clip-e clip-e1"><span class="clip-img big"></span></div>
      <div class="clip-e clip-e2"><span class="link">estris.app</span></div>
      <div class="clip-n clip-n1 pill">1 of 3</div>
      <div class="clip-n clip-n2 pill">2 of 3</div>
    </div>
    <Cursor class="clip-cursor" />
  </div>
  <div class="keys clip-keys-c"><span class="key">⌘</span><span class="key clip-c">C</span></div>
  <div class="keys clip-keys-v"><span class="key">⌘</span><span class="key">⇧</span><span class="key clip-v">V</span></div>
</div>

<style is:global>
  .s-clip .clip-source { left: 4%; top: 8%; width: 44%; height: 84%; }
  .s-clip .clip-doc { left: 52%; top: 8%; width: 44%; height: 84%; }
  .s-clip .clip-item { position: absolute; left: 6%; right: 6%; display: flex; align-items: center; }
  .s-clip .clip-i1 { top: 14%; height: 12%; }
  .s-clip .clip-i2 { top: 32%; height: 12%; }
  .s-clip .clip-i3 { top: 50%; height: 34%; }
  .s-clip .clip-sel { position: absolute; inset: 0; border-radius: 0.8cqw; background: rgba(10, 132, 255, 0.45); transform-origin: left; transform: scaleX(0); }
  .s-clip .clip-text { position: relative; padding-left: 1.4cqw; font-size: 3cqw; font-weight: 500; white-space: nowrap; }
  .s-clip .link { color: #64b5ff; text-decoration: underline; }
  .s-clip .clip-img { position: relative; display: block; width: 100%; height: 100%; border-radius: 1cqw; background: linear-gradient(135deg, #ff9f0a, #ff375f 55%, #bf5af2); }
  .s-clip .clip-i3 .clip-sel { inset: -0.8cqw; transform: none; opacity: 0; background: none; box-shadow: 0 0 0 0.6cqw #0a84ff; border-radius: 1.6cqw; }
  .s-clip .clip-img.big { width: 36cqw; height: 20cqw; border-radius: 1.4cqw; }
  .s-clip .clip-slot { position: absolute; left: 8%; right: 8%; top: 14%; height: 12%; display: flex; align-items: center; font-size: 3cqw; font-weight: 500; }
  .s-clip .clip-caret { width: 0.35cqw; height: 4cqw; background: #f5f5f7; opacity: 0; }
  .s-clip .clip-pasted { opacity: 0; margin-left: 0.4cqw; }
  .s-clip .clip-lines { position: absolute; left: 8%; right: 8%; top: 34%; display: flex; flex-direction: column; gap: 1.6cqw; }
  .s-clip .clip-lines b { display: block; height: 1.2cqw; border-radius: 1cqw; background: rgba(255, 255, 255, 0.14); }
  .s-clip .clip-lines b:nth-child(2) { width: 80%; }
  .s-clip .clip-lines b:nth-child(3) { width: 60%; }
  .s-clip .clip-card {
    position: absolute; left: 16%; top: 20%; width: 68%; height: 56%; border-radius: 2.4cqw; z-index: 30;
    background: rgba(58, 58, 64, 0.9); backdrop-filter: blur(2cqw);
    box-shadow: 0 0 0 0.25cqw rgba(255, 255, 255, 0.16), 0 3cqw 6cqw rgba(0, 0, 0, .5);
    opacity: 0; transform: scale(.94);
  }
  .s-clip .clip-e { position: absolute; inset: 0 0 18% 0; display: flex; align-items: center; justify-content: center; font-size: 4.6cqw; font-weight: 600; opacity: 0; }
  .s-clip .clip-n { position: absolute; left: 50%; bottom: 6%; transform: translateX(-50%); opacity: 0; }
  .s-clip .clip-cursor { left: 75%; top: 85%; }
  .s-clip .keys { opacity: 0; }

  .s-clip.playing .clip-cursor { animation: clip-cursor var(--d) cubic-bezier(.45, 0, .25, 1) both; }
  .s-clip.playing .clip-i1 .clip-sel { animation: clip-sel1 var(--d) cubic-bezier(.45, 0, .25, 1) both; }
  .s-clip.playing .clip-i2 .clip-sel { animation: clip-sel2 var(--d) cubic-bezier(.45, 0, .25, 1) both; }
  .s-clip.playing .clip-i3 .clip-sel { animation: clip-sel3 var(--d) ease both; }
  .s-clip.playing .clip-caret { animation: clip-caret var(--d) step-end both; }
  .s-clip.playing .clip-pasted { animation: clip-pasted var(--d) ease both; }
  .s-clip.playing .clip-card { animation: clip-card var(--d) ease both; }
  .s-clip.playing .clip-e1, .s-clip.playing .clip-n1 { animation: clip-s1 var(--d) ease both; }
  .s-clip.playing .clip-e2, .s-clip.playing .clip-n2 { animation: clip-s2 var(--d) ease both; }
  .s-clip.playing .clip-keys-c { animation: clip-keys-c var(--d) ease both; }
  .s-clip.playing .clip-c { animation: clip-c var(--d) ease both; }
  .s-clip.playing .clip-keys-v { animation: clip-keys-v var(--d) ease both; }
  .s-clip.playing .clip-v { animation: clip-v var(--d) ease both; }

  @keyframes clip-cursor {
    0%, 3% { left: 75%; top: 85%; }
    8% { left: 7%; top: 24.8%; }
    14% { left: 40%; top: 24.8%; }
    20% { left: 7%; top: 39.9%; }
    25% { left: 30%; top: 39.9%; }
    31% { left: 26%; top: 64%; transform: none; }
    32% { left: 26%; top: 64%; transform: scale(.85); }
    33% { left: 26%; top: 64%; transform: none; }
    42% { left: 57.3%; top: 24.8%; transform: none; }
    43% { left: 57.3%; top: 24.8%; transform: scale(.85); }
    44%, 86% { left: 57.3%; top: 24.8%; transform: none; }
    98%, 100% { left: 75%; top: 85%; }
  }
  @keyframes clip-sel1 { 0%, 8% { transform: scaleX(0); opacity: 1; } 14%, 18% { transform: scaleX(1); opacity: 1; } 21%, 100% { transform: scaleX(1); opacity: 0; } }
  @keyframes clip-sel2 { 0%, 20% { transform: scaleX(0); opacity: 1; } 25%, 29% { transform: scaleX(1); opacity: 1; } 32%, 100% { transform: scaleX(1); opacity: 0; } }
  @keyframes clip-sel3 { 0%, 32% { opacity: 0; } 33%, 39% { opacity: 1; } 42%, 100% { opacity: 0; } }
  @keyframes clip-caret { 0% { opacity: 0; } 44% { opacity: 1; } 47% { opacity: 0; } 50% { opacity: 1; } 69% { opacity: 0; } 100% { opacity: 0; } }
  @keyframes clip-pasted { 0%, 67% { opacity: 0; transform: translateY(1cqw); } 70%, 84% { opacity: 1; transform: none; } 90%, 100% { opacity: 0; transform: none; } }
  @keyframes clip-card {
    0%, 47% { opacity: 0; transform: scale(.94); }
    49%, 65% { opacity: 1; transform: none; }
    68%, 100% { opacity: 0; transform: scale(.97); }
  }
  @keyframes clip-s1 { 0%, 47% { opacity: 0; } 49%, 56% { opacity: 1; } 57%, 100% { opacity: 0; } }
  @keyframes clip-s2 { 0%, 56% { opacity: 0; } 57%, 66% { opacity: 1; } 68%, 100% { opacity: 0; } }
  @keyframes clip-keys-c { 0%, 12% { opacity: 0; } 14%, 36% { opacity: 1; } 39%, 100% { opacity: 0; } }
  @keyframes clip-c {
    0%, 15% { transform: none; background: #2c2c31; } 16%, 18% { transform: translateY(.5cqw); background: #0a84ff; }
    19%, 26% { transform: none; background: #2c2c31; } 27%, 29% { transform: translateY(.5cqw); background: #0a84ff; }
    30%, 33% { transform: none; background: #2c2c31; } 34%, 36% { transform: translateY(.5cqw); background: #0a84ff; }
    37%, 100% { transform: none; background: #2c2c31; }
  }
  @keyframes clip-keys-v { 0%, 44% { opacity: 0; } 46%, 66% { opacity: 1; } 69%, 100% { opacity: 0; } }
  @keyframes clip-v {
    0%, 47% { transform: none; background: #2c2c31; } 48%, 50% { transform: translateY(.5cqw); background: #0a84ff; }
    51%, 56% { transform: none; background: #2c2c31; } 57%, 59% { transform: translateY(.5cqw); background: #0a84ff; }
    60%, 100% { transform: none; background: #2c2c31; }
  }
</style>
