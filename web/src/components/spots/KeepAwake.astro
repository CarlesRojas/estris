---
/** A still picture: Keep Awake's settings, on, and what it is doing. */
const { d } = Astro.props;
---
<div class="spot s-awake" style={`--d:${d}s`}>
  <div class="awake-card">
    <div class="awake-head">
      <span class="awake-tile">
        <svg viewBox="0 0 24 24"><path d="M4 9h12v5a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5z" fill="currentColor"/><path d="M16 10.5h1.5a2.5 2.5 0 0 1 0 5H16" stroke="currentColor" stroke-width="1.8" fill="none"/><path d="M8 3.5c-1 1.2 1 1.8 0 3M12 3.5c-1 1.2 1 1.8 0 3" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round"/></svg>
      </span>
      <span class="awake-name">Keep Awake</span>
      <span class="awake-switch on"><i></i></span>
    </div>
    <div class="awake-row"><span>On power adapter</span><span class="awake-value">Indefinitely</span></div>
    <div class="awake-row"><span>On battery</span><span class="awake-value">1 hour</span></div>
    <div class="awake-row"><span>Start the screen saver instead</span><span class="awake-switch small on"><i></i></span></div>
  </div>
  <div class="awake-pill"><span class="pill"><span class="awake-dot"></span>Awake · Indefinitely</span></div>
</div>

<style is:global>
  .s-awake .awake-card {
    position: absolute; left: 9%; top: 9%; width: 82%; padding: 4cqw; border-radius: 3cqw; display: flex; flex-direction: column; gap: 1.6cqw;
    background: rgba(40, 40, 45, 0.95); box-shadow: 0 0 0 0.25cqw rgba(255, 255, 255, 0.14), 0 3cqw 6cqw rgba(0, 0, 0, .4);
  }
  .s-awake .awake-head { display: flex; align-items: center; gap: 2.4cqw; padding-bottom: 2cqw; }
  .s-awake .awake-tile { width: 9cqw; height: 9cqw; border-radius: 2.2cqw; background: #ff9f0a; color: #fff; display: grid; place-items: center; }
  .s-awake .awake-tile svg { width: 60%; height: 60%; }
  .s-awake .awake-name { flex: 1; font-size: 4.4cqw; font-weight: 700; }
  .s-awake .awake-switch { position: relative; width: 9cqw; height: 5.4cqw; border-radius: 3cqw; background: #30d158; }
  .s-awake .awake-switch i { position: absolute; right: 0.5cqw; top: 0.5cqw; width: 4.4cqw; height: 4.4cqw; border-radius: 50%; background: #fff; }
  .s-awake .awake-switch.small { width: 6.4cqw; height: 3.8cqw; }
  .s-awake .awake-switch.small i { width: 2.9cqw; height: 2.9cqw; right: 0.45cqw; top: 0.45cqw; }
  .s-awake .awake-row {
    display: flex; align-items: center; justify-content: space-between; gap: 2cqw; padding: 2.4cqw 2.6cqw; border-radius: 1.8cqw;
    background: rgba(255, 255, 255, 0.06); font-size: 3cqw;
  }
  .s-awake .awake-value { color: rgba(245, 245, 247, .6); }
  .s-awake .awake-pill { position: absolute; left: 0; right: 0; top: 80%; display: flex; justify-content: center; }
  .s-awake .awake-pill .pill { font-size: 3.4cqw; padding: 1.6cqw 3cqw; }
  .s-awake .awake-dot { width: 2.2cqw; height: 2.2cqw; border-radius: 50%; background: #30d158; box-shadow: 0 0 1.4cqw #30d158; }
</style>
