---
import Cursor from "../Cursor.astro";
import { pointer } from "../../lib/motion";
/** A three-finger tap on the link opens it in a new tab; the same tap on that tab closes it,
    and the pointer goes back to the link, so it loops. */
const { d } = Astro.props;
const css = pointer("mid-cursor", [[0, 13, 42], [22, 13, 42], [31, 26, 9], [60, 26, 9], [70, 13, 42], [100, 13, 42]]);
---
<div class="spot s-mid" style={`--d:${d}s`}>
  <div class="mid-browser">
    <div class="mid-tabs">
      <span class="mid-tab mid-tab-1">Notes</span>
      <span class="mid-tab mid-tab-2">estris.app</span>
    </div>
    <div class="mid-page">
      <b></b><b></b><span class="mid-link">estris.app</span><b></b>
    </div>
    <Cursor class="mid-cursor" />
  </div>
  <div class="mid-pad">
    <i class="mid-finger"></i><i class="mid-finger"></i><i class="mid-finger"></i>
  </div>
</div>

<style is:global>
  .s-mid .mid-browser {
    position: absolute; left: 8%; top: 6%; width: 84%; height: 48%; border-radius: 2cqw; overflow: hidden;
    background: #2c2c31; box-shadow: 0 0 0 0.2cqw rgba(255, 255, 255, 0.13), 0 2cqw 4cqw rgba(0, 0, 0, .4);
  }
  .s-mid .mid-tabs { display: flex; gap: 1cqw; padding: 1.6cqw 1.6cqw 0; background: rgba(255, 255, 255, 0.05); height: 7.4cqw; }
  .s-mid .mid-tab { display: flex; align-items: center; padding: 0 2.4cqw; border-radius: 1.2cqw 1.2cqw 0 0; font-size: 2.6cqw; font-weight: 600; }
  .s-mid .mid-tab-1 { background: #2c2c31; }
  .s-mid .mid-tab-2 { background: rgba(255, 255, 255, .08); color: rgba(245, 245, 247, .75); opacity: 0; transform: translateY(100%); }
  .s-mid .mid-page { padding: 3cqw; display: flex; flex-direction: column; gap: 1.8cqw; }
  .s-mid .mid-page b { display: block; height: 1.4cqw; width: 80%; border-radius: 1cqw; background: rgba(255, 255, 255, .14); }
  .s-mid .mid-page b:nth-child(2) { width: 60%; }
  .s-mid .mid-link { font-size: 3.4cqw; font-weight: 600; color: #9cc3ff; text-decoration: underline; }
  .s-mid .mid-cursor { left: 13%; top: 42%; }
  .s-mid .mid-pad {
    position: absolute; left: 22%; top: 62%; width: 56%; height: 32%; border-radius: 2.4cqw;
    background: linear-gradient(160deg, #3a3a40, #2a2a2f); box-shadow: 0 0 0 0.25cqw rgba(255, 255, 255, 0.15), 0 2cqw 4cqw rgba(0, 0, 0, .35);
    display: flex; justify-content: center; align-items: center; gap: 4cqw;
  }
  .s-mid .mid-finger { width: 7cqw; height: 7cqw; border-radius: 50%; background: rgba(255, 255, 255, .85); opacity: 0; transform: scale(1.4); }
  .s-mid .mid-finger:nth-child(2) { margin-top: -4cqw; }

  .s-mid .mid-link, .s-mid .mid-tab-2 { transform-origin: left center; }
  .s-mid.playing .mid-cursor { animation: mid-cursor-x var(--d) both, mid-cursor-y var(--d) both; }
  .s-mid.playing .mid-finger { animation: mid-finger var(--d) both; }
  .s-mid.playing .mid-finger:nth-child(2) { animation-delay: 40ms; }
  .s-mid.playing .mid-finger:nth-child(3) { animation-delay: 80ms; }
  .s-mid.playing .mid-tab-2 { animation: mid-tab var(--d) both; }
  .s-mid.playing .mid-link { animation: mid-link var(--d) both; }
  .s-mid.playing .mid-pad { animation: mid-pad var(--d) both; }

  /* Two taps: fingers land with a squash, the pad gives a little, then they lift. */
  @keyframes mid-finger {
    0%, 8% { opacity: 0; transform: scale(1.5); animation-timing-function: cubic-bezier(.2, 0, 0, 1); }
    10.5% { opacity: 1; transform: scale(1); }
    11.5% { opacity: 1; transform: scale(1.15, .8); }
    12.8% { opacity: 1; transform: scale(.95, 1.05); }
    14% { opacity: 1; transform: none; animation-timing-function: cubic-bezier(.3, 0, 1, 1); }
    16.5%, 44% { opacity: 0; transform: scale(1.3); animation-timing-function: cubic-bezier(.2, 0, 0, 1); }
    46.5% { opacity: 1; transform: scale(1); }
    47.5% { opacity: 1; transform: scale(1.15, .8); }
    48.8% { opacity: 1; transform: scale(.95, 1.05); }
    50% { opacity: 1; transform: none; animation-timing-function: cubic-bezier(.3, 0, 1, 1); }
    52.5%, 100% { opacity: 0; transform: scale(1.3); }
  }
  @keyframes mid-pad {
    0%, 11% { transform: none; } 11.8% { transform: scale(.985); } 13.5%, 47% { transform: none; } 47.8% { transform: scale(.985); } 49.5%, 100% { transform: none; }
  }
  @keyframes mid-link { 0%, 11% { transform: none; } 12% { transform: scale(.94); } 13.5% { transform: scale(1.05); } 15%, 100% { transform: none; } }
  /* The new tab springs up, and drops away when closed. */
  @keyframes mid-tab {
    0%, 13.5% { opacity: 0; transform: translateY(100%) scale(.8); animation-timing-function: cubic-bezier(.34, 1.56, .64, 1); }
    18%, 48% { opacity: 1; transform: none; }
    48% { animation-timing-function: cubic-bezier(.3, 0, 1, 1); }
    49% { opacity: 1; transform: scale(.94); animation-timing-function: cubic-bezier(.3, 0, 1, 1); }
    52%, 100% { opacity: 0; transform: translateY(100%) scale(.8); }
  }
</style>
<Fragment set:html={`<style>${css}</style>`} />
