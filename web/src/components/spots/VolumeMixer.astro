---
import Cursor from "../Cursor.astro";
/** The mixer: the music goes up, the browser down and then muted, and the call moves to
    AirPods. */
const { d } = Astro.props;
const rows = [
  { id: "music", name: "Music", color: "#ff375f", device: "Same as System", value: 50 },
  { id: "web", name: "Browser", color: "#ff9f0a", device: "Same as System", value: 60 },
  { id: "call", name: "Call", color: "#30d158", device: "MacBook Speakers", value: 70 },
];
---
<div class="spot s-vol" style={`--d:${d}s`}>
  <div class="vol-panel">
    <div class="vol-title">Apps Volume</div>
    {rows.map((row) => (
      <div class={`vol-row vol-${row.id}`}>
        <div class="vol-top">
          <span class="vol-tile" style={`background:${row.color}`}></span>
          <span class="vol-name">{row.name}</span>
          <span class="vol-device">
            <span class="vol-dev-a">{row.device}</span>
            {row.id === "call" && <span class="vol-dev-b">AirPods Pro</span>}
          </span>
        </div>
        <div class="vol-bottom">
          <span class="vol-speaker">
            <svg class="vol-on" viewBox="0 0 24 24"><path d="M4 9h4l5-4v14l-5-4H4z" fill="currentColor"/><path d="M16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/></svg>
            <svg class="vol-off" viewBox="0 0 24 24"><path d="M4 9h4l5-4v14l-5-4H4z" fill="currentColor"/><path d="M16 9l6 6M22 9l-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </span>
          <span class="vol-track"><span class="vol-fill" style={`width:${row.value}%`}></span><span class="vol-knob" style={`left:${row.value}%`}></span></span>
          <span class="vol-bars"><i></i><i></i><i></i><i></i></span>
        </div>
      </div>
    ))}
    <Cursor class="vol-cursor" />
  </div>
</div>

<style is:global>
  .s-vol .vol-panel {
    position: absolute; left: 10%; top: 12%; width: 80%; height: 76%; border-radius: 3cqw; padding: 4cqw;
    background: rgba(40, 40, 45, 0.94); box-shadow: 0 0 0 0.25cqw rgba(255, 255, 255, 0.14), 0 3cqw 6cqw rgba(0, 0, 0, .4);
    display: flex; flex-direction: column; gap: 3cqw;
  }
  .s-vol .vol-title { font-size: 2.6cqw; font-weight: 600; color: rgba(245, 245, 247, .55); }
  .s-vol .vol-row { display: flex; flex-direction: column; gap: 1.8cqw; padding: 2.6cqw; border-radius: 2cqw; background: rgba(255, 255, 255, 0.06); }
  .s-vol .vol-top { display: flex; align-items: center; gap: 2cqw; }
  .s-vol .vol-tile { width: 5.4cqw; height: 5.4cqw; border-radius: 1.3cqw; }
  .s-vol .vol-name { font-size: 3.3cqw; font-weight: 600; flex: 1; }
  .s-vol .vol-device { position: relative; font-size: 2.6cqw; color: rgba(245, 245, 247, .6); display: grid; justify-items: end; }
  .s-vol .vol-device > span { grid-area: 1 / 1; white-space: nowrap; }
  .s-vol .vol-dev-b { opacity: 0; color: #64b5ff; font-weight: 600; }
  .s-vol .vol-bottom { display: flex; align-items: center; gap: 2cqw; }
  .s-vol .vol-speaker { position: relative; width: 4cqw; height: 4cqw; color: rgba(245, 245, 247, .8); }
  .s-vol .vol-speaker svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .s-vol .vol-off { opacity: 0; color: #ff453a; }
  .s-vol .vol-track { position: relative; flex: 1; height: 1.2cqw; border-radius: 1cqw; background: rgba(255, 255, 255, 0.14); }
  .s-vol .vol-fill { position: absolute; left: 0; top: 0; bottom: 0; border-radius: 1cqw; background: #f5f5f7; }
  .s-vol .vol-knob { position: absolute; top: 50%; width: 3.6cqw; height: 3.6cqw; margin: -1.8cqw 0 0 -1.8cqw; border-radius: 50%; background: #fff; box-shadow: 0 0.4cqw 1cqw rgba(0, 0, 0, .4); }
  .s-vol .vol-bars { display: flex; align-items: center; gap: 0.6cqw; width: 6cqw; height: 4cqw; }
  .s-vol .vol-bars i { flex: 1; height: 40%; border-radius: 1cqw; background: rgba(245, 245, 247, .7); transform-origin: center; }
  .s-vol .vol-cursor { left: 80%; top: 95%; }

  /* The bars move all along, each app at its own volume. */
  .s-vol.playing .vol-bars i { animation: vol-bounce .9s ease-in-out infinite alternate; }
  .s-vol.playing .vol-bars i:nth-child(2) { animation-delay: -.3s; }
  .s-vol.playing .vol-bars i:nth-child(3) { animation-delay: -.6s; }
  .s-vol.playing .vol-bars i:nth-child(4) { animation-delay: -.45s; }
  @keyframes vol-bounce { from { transform: scaleY(.6); } to { transform: scaleY(1.9); } }

  .s-vol.playing .vol-music .vol-fill { animation: vol-music-fill var(--d) cubic-bezier(.45, 0, .25, 1) both; }
  .s-vol.playing .vol-music .vol-knob { animation: vol-music-knob var(--d) cubic-bezier(.45, 0, .25, 1) both; }
  .s-vol.playing .vol-music .vol-bars { animation: vol-music-bars var(--d) ease both; }
  .s-vol.playing .vol-web .vol-fill { animation: vol-web-fill var(--d) cubic-bezier(.45, 0, .25, 1) both; }
  .s-vol.playing .vol-web .vol-knob { animation: vol-web-knob var(--d) cubic-bezier(.45, 0, .25, 1) both; }
  .s-vol.playing .vol-web .vol-bars { animation: vol-web-bars var(--d) ease both; }
  .s-vol.playing .vol-web .vol-on { animation: vol-web-on var(--d) ease both; }
  .s-vol.playing .vol-web .vol-off { animation: vol-web-off var(--d) ease both; }
  .s-vol.playing .vol-dev-a { animation: vol-dev-a var(--d) ease both; }
  .s-vol.playing .vol-dev-b { animation: vol-dev-b var(--d) ease both; }
  .s-vol.playing .vol-cursor { animation: vol-cursor var(--d) cubic-bezier(.45, 0, .25, 1) both; }

  @keyframes vol-music-fill { 0%, 12% { width: 50%; } 28%, 100% { width: 88%; } }
  @keyframes vol-music-knob { 0%, 12% { left: 50%; } 28%, 100% { left: 88%; } }
  @keyframes vol-music-bars { 0%, 12% { transform: scale(1); } 28%, 100% { transform: scale(1.25); } }
  @keyframes vol-web-fill { 0%, 34% { width: 60%; background: #f5f5f7; } 48%, 55% { width: 22%; background: #f5f5f7; } 58%, 100% { width: 22%; background: rgba(245, 245, 247, .3); } }
  @keyframes vol-web-knob { 0%, 34% { left: 60%; } 48%, 100% { left: 22%; } }
  @keyframes vol-web-bars { 0%, 34% { opacity: 1; transform: scale(1); } 48%, 55% { opacity: 1; transform: scale(.7); } 58%, 100% { opacity: .15; transform: scale(.4); } }
  @keyframes vol-web-on { 0%, 56% { opacity: 1; } 58%, 100% { opacity: 0; } }
  @keyframes vol-web-off { 0%, 56% { opacity: 0; } 58%, 100% { opacity: 1; } }
  @keyframes vol-dev-a { 0%, 76% { opacity: 1; } 79%, 100% { opacity: 0; } }
  @keyframes vol-dev-b { 0%, 76% { opacity: 0; } 79%, 100% { opacity: 1; } }
  @keyframes vol-cursor {
    0% { left: 80%; top: 95%; }
    10%, 12% { left: 50%; top: 33%; }
    28%, 30% { left: 88%; top: 33%; }
    34% { left: 60%; top: 56%; }
    48% { left: 22%; top: 56%; }
    54%, 58% { left: 9%; top: 56%; }
    72%, 100% { left: 84%; top: 70%; }
  }
</style>
