---
import Cursor from "../Cursor.astro";
/** Music up, the browser down and muted, the call to AirPods; then all of it undone, so it
    loops. The pointer holds each knob as it drags it: rows are laid out at fixed positions so
    the pointer's path and the knobs' share the same numbers. */
const { d } = Astro.props;
const rows = [
  { id: "music", name: "Music", color: "#ff375f", device: "Same as System", value: 50 },
  { id: "web", name: "Browser", color: "#ff9f0a", device: "Same as System", value: 60 },
  { id: "call", name: "Call", color: "#30d158", device: "MacBook Speakers", value: 70 },
];
---
<div class="spot s-vol" style={`--d:${d}s`}>
  <div class="vol-panel">
    <div class="vol-title">Apps Volume</div>
    {rows.map((row) => (
      <div class={`vol-row vol-${row.id}`}>
        <span class="vol-tile" style={`background:${row.color}`}></span>
        <span class="vol-name">{row.name}</span>
        <span class="vol-device">
          <span class="vol-dev-a">{row.device}</span>
          {row.id === "call" && <span class="vol-dev-b">AirPods Pro</span>}
        </span>
        <span class="vol-speaker">
          <svg class="vol-on" viewBox="0 0 24 24"><path d="M4 9h4l5-4v14l-5-4H4z" fill="currentColor"/><path d="M16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/></svg>
          <svg class="vol-off" viewBox="0 0 24 24"><path d="M4 9h4l5-4v14l-5-4H4z" fill="currentColor"/><path d="M16 9l6 6M22 9l-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </span>
        <span class="vol-track"><span class="vol-fill" style={`width:${row.value}%`}></span><span class="vol-knob" style={`left:${row.value}%`}></span></span>
      </div>
    ))}
    <Cursor class="vol-cursor" />
  </div>
</div>

<style is:global>
  /* All in % of the panel (a square) and of each row, so the pointer's stops are exact:
     a knob at value v is at x = 4 + 0.92 × (16 + 79v), y = row top + 18.72. */
  .s-vol .vol-panel {
    position: absolute; left: 8%; top: 8%; width: 84%; height: 84%; border-radius: 3cqw;
    background: rgba(40, 40, 45, 0.95); box-shadow: 0 0 0 0.25cqw rgba(255, 255, 255, 0.14), 0 3cqw 6cqw rgba(0, 0, 0, .4);
  }
  .s-vol .vol-title { position: absolute; left: 5%; top: 3.5%; font-size: 2.6cqw; font-weight: 600; color: rgba(245, 245, 247, .55); }
  .s-vol .vol-row { position: absolute; left: 4%; width: 92%; height: 26%; border-radius: 2cqw; background: rgba(255, 255, 255, 0.06); }
  .s-vol .vol-music { top: 12%; } .s-vol .vol-web { top: 41%; } .s-vol .vol-call { top: 70%; }
  .s-vol .vol-tile { position: absolute; left: 4%; top: 12%; width: 5.4cqw; height: 5.4cqw; border-radius: 1.3cqw; }
  .s-vol .vol-name { position: absolute; left: 14%; top: 12%; line-height: 5.4cqw; font-size: 3.3cqw; font-weight: 600; }
  .s-vol .vol-device { position: absolute; right: 4%; top: 12%; height: 5.4cqw; display: grid; justify-items: end; align-items: center; font-size: 2.6cqw; color: rgba(245, 245, 247, .6); }
  .s-vol .vol-device > span { grid-area: 1 / 1; white-space: nowrap; }
  .s-vol .vol-dev-b { opacity: 0; color: #64b5ff; font-weight: 600; }
  .s-vol .vol-speaker { position: absolute; left: 4%; top: 62%; width: 4cqw; height: 4cqw; color: rgba(245, 245, 247, .8); }
  .s-vol .vol-speaker svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .s-vol .vol-off { opacity: 0; color: #ff453a; }
  .s-vol .vol-track { position: absolute; left: 16%; right: 5%; top: calc(72% - 0.6cqw); height: 1.2cqw; border-radius: 1cqw; background: rgba(255, 255, 255, 0.14); }
  .s-vol .vol-fill { position: absolute; left: 0; top: 0; bottom: 0; border-radius: 1cqw; background: #f5f5f7; }
  .s-vol .vol-knob { position: absolute; top: 50%; width: 3.6cqw; height: 3.6cqw; margin: -1.8cqw 0 0 -1.8cqw; border-radius: 50%; background: #fff; box-shadow: 0 0.4cqw 1cqw rgba(0, 0, 0, .4); }
  .s-vol .vol-cursor { left: 84%; top: 76.33%; }

  .s-vol.playing .vol-cursor { animation: vol-cursor var(--d) cubic-bezier(.45, 0, .25, 1) both; }
  .s-vol.playing .vol-music .vol-fill { animation: vol-music-fill var(--d) cubic-bezier(.45, 0, .25, 1) both; }
  .s-vol.playing .vol-music .vol-knob { animation: vol-music-knob var(--d) cubic-bezier(.45, 0, .25, 1) both; }
  .s-vol.playing .vol-web .vol-fill { animation: vol-web-fill var(--d) cubic-bezier(.45, 0, .25, 1) both; }
  .s-vol.playing .vol-web .vol-knob { animation: vol-web-knob var(--d) cubic-bezier(.45, 0, .25, 1) both; }
  .s-vol.playing .vol-web .vol-on { animation: vol-web-on var(--d) step-end both; }
  .s-vol.playing .vol-web .vol-off { animation: vol-web-off var(--d) step-end both; }
  .s-vol.playing .vol-dev-a { animation: vol-dev-a var(--d) ease both; }
  .s-vol.playing .vol-dev-b { animation: vol-dev-b var(--d) ease both; }

  @keyframes vol-cursor {
    0%, 2% { left: 84%; top: 76.33%; transform: none; }
    8% { left: 55.06%; top: 30.72%; }
    18% { left: 80.5%; top: 30.72%; }
    24% { left: 62.33%; top: 59.72%; }
    34% { left: 36.89%; top: 59.72%; }
    40% { left: 10.06%; top: 59.5%; transform: none; }
    41% { left: 10.06%; top: 59.5%; transform: scale(.85); }
    42% { left: 10.06%; top: 59.5%; transform: none; }
    48% { left: 84%; top: 76.33%; transform: none; }
    49% { left: 84%; top: 76.33%; transform: scale(.85); }
    50% { left: 84%; top: 76.33%; transform: none; }
    56% { left: 10.06%; top: 59.5%; transform: none; }
    57% { left: 10.06%; top: 59.5%; transform: scale(.85); }
    58% { left: 10.06%; top: 59.5%; transform: none; }
    63% { left: 36.89%; top: 59.72%; }
    73% { left: 62.33%; top: 59.72%; }
    79% { left: 80.5%; top: 30.72%; }
    89% { left: 55.06%; top: 30.72%; }
    96% { left: 84%; top: 76.33%; transform: none; }
    97% { left: 84%; top: 76.33%; transform: scale(.85); }
    98%, 100% { left: 84%; top: 76.33%; transform: none; }
  }
  @keyframes vol-music-fill { 0%, 8% { width: 50%; } 18%, 79% { width: 85%; } 89%, 100% { width: 50%; } }
  @keyframes vol-music-knob { 0%, 8% { left: 50%; } 18%, 79% { left: 85%; } 89%, 100% { left: 50%; } }
  @keyframes vol-web-fill {
    0%, 24% { width: 60%; background: #f5f5f7; }
    34%, 41% { width: 25%; background: #f5f5f7; }
    42%, 57% { width: 25%; background: rgba(245, 245, 247, .3); }
    58%, 63% { width: 25%; background: #f5f5f7; }
    73%, 100% { width: 60%; background: #f5f5f7; }
  }
  @keyframes vol-web-knob { 0%, 24% { left: 60%; } 34%, 63% { left: 25%; } 73%, 100% { left: 60%; } }
  @keyframes vol-web-on { 0% { opacity: 1; } 41% { opacity: 0; } 57% { opacity: 1; } 100% { opacity: 1; } }
  @keyframes vol-web-off { 0% { opacity: 0; } 41% { opacity: 1; } 57% { opacity: 0; } 100% { opacity: 0; } }
  @keyframes vol-dev-a { 0%, 49% { opacity: 1; } 50%, 97% { opacity: 0; } 98%, 100% { opacity: 1; } }
  @keyframes vol-dev-b { 0%, 49% { opacity: 0; } 50%, 97% { opacity: 1; } 98%, 100% { opacity: 0; } }
</style>
