---
import Cursor from "../Cursor.astro";
import { pointer, presses } from "../../lib/motion";
/** Music up, the browser down and muted, the call to AirPods; then all of it undone, so it
    loops. The pointer holds each knob as it drags it: rows are laid out at fixed positions so
    the pointer's path and the knobs' share the same numbers. */
const { d } = Astro.props;
// Knob x for a value v: 4 + 0.92 × (16 + 79v); row tracks at y 30.72 and 59.72; the browser's
// speaker at (10.06, 59.5); the call's device at (84, 76.33).
const css = [
  pointer("vol-cursor", [
    [0, 84, 76.33], [2, 84, 76.33], [7, 55.06, 30.72], [8.6, 55.06, 30.72], [16, 80.5, 30.72], [17, 80.5, 30.72],
    [22, 62.33, 59.72], [23.6, 62.33, 59.72], [31, 36.89, 59.72], [32, 36.89, 59.72], [37, 10.06, 59.5], [40, 10.06, 59.5],
    [45, 84, 76.33], [49, 84, 76.33], [54, 10.06, 59.5], [58, 10.06, 59.5], [62, 36.89, 59.72], [62.6, 36.89, 59.72], [70, 62.33, 59.72],
    [71, 62.33, 59.72], [76, 80.5, 30.72], [76.6, 80.5, 30.72], [84, 55.06, 30.72], [85, 55.06, 30.72], [92, 84, 76.33], [100, 84, 76.33],
  ]),
  presses("vol-press", [38, 46.5, 55.5, 93.5], [[8, 16], [23, 31], [62, 70], [76, 84]]),
].join("\n");
const rows = [
  { id: "music", name: "Music", color: "var(--pink)", device: "Same as System", value: 50 },
  { id: "web", name: "Browser", color: "var(--orange)", device: "Same as System", value: 60 },
  { id: "call", name: "Call", color: "var(--green)", device: "MacBook Speakers", value: 70 },
];
---
<div class="spot s-vol" style={`--d:${d}s`}>
  <div class="vol-panel">
    <div class="vol-title">Apps Volume</div>
    {rows.map((row) => (
      <div class={`vol-row vol-${row.id}`}>
        <span class="vol-tile" style={`background:${row.color}`}></span>
        <span class="vol-name">{row.name}</span>
        <span class="vol-device">
          <span class="vol-dev-a">{row.device}</span>
          {row.id === "call" && <span class="vol-dev-b">AirPods Pro</span>}
        </span>
        <span class="vol-speaker">
          <svg class="vol-on" viewBox="0 0 24 24"><path d="M4 9h4l5-4v14l-5-4H4z" fill="currentColor"/><path d="M16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/></svg>
          <svg class="vol-off" viewBox="0 0 24 24"><path d="M4 9h4l5-4v14l-5-4H4z" fill="currentColor"/><path d="M16 9l6 6M22 9l-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </span>
        <span class="vol-track"><span class="vol-fill" style={`width:${row.value}%`}></span><span class="vol-knob" style={`left:${row.value}%`}></span></span>
      </div>
    ))}
    <Cursor class="vol-cursor" />
  </div>
</div>

<style is:global>
  /* All in % of the panel (a square) and of each row, so the pointer's stops are exact:
     a knob at value v is at x = 4 + 0.92 × (16 + 79v), y = row top + 18.72. */
  .s-vol .vol-panel {
    position: absolute; left: 8%; top: 8%; width: 84%; height: 84%; border-radius: 3cqw;
    background: rgba(40, 40, 45, 0.95); box-shadow: 0 0 0 0.25cqw rgba(255, 255, 255, 0.14), 0 3cqw 6cqw rgba(0, 0, 0, .4);
  }
  .s-vol .vol-title { position: absolute; left: 5%; top: 3.5%; font-size: 2.6cqw; font-weight: 600; color: rgba(245, 245, 247, .55); }
  .s-vol .vol-row { position: absolute; left: 4%; width: 92%; height: 26%; border-radius: 2cqw; background: rgba(255, 255, 255, 0.06); }
  .s-vol .vol-music { top: 12%; } .s-vol .vol-web { top: 41%; } .s-vol .vol-call { top: 70%; }
  .s-vol .vol-tile { position: absolute; left: 4%; top: 12%; width: 5.4cqw; height: 5.4cqw; border-radius: 1.3cqw; }
  .s-vol .vol-name { position: absolute; left: 14%; top: 12%; line-height: 5.4cqw; font-size: 3.3cqw; font-weight: 600; }
  .s-vol .vol-device { position: absolute; right: 4%; top: 12%; height: 5.4cqw; display: grid; justify-items: end; align-items: center; font-size: 2.6cqw; color: rgba(245, 245, 247, .6); }
  .s-vol .vol-device > span { grid-area: 1 / 1; white-space: nowrap; }
  .s-vol .vol-dev-b { opacity: 0; color: #9cc3ff; font-weight: 600; }
  .s-vol .vol-speaker { position: absolute; left: 4%; top: 62%; width: 4cqw; height: 4cqw; color: rgba(245, 245, 247, .8); }
  .s-vol .vol-speaker svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .s-vol .vol-off { opacity: 0; color: var(--red); }
  .s-vol .vol-track { position: absolute; left: 16%; right: 5%; top: calc(72% - 0.6cqw); height: 1.2cqw; border-radius: 1cqw; background: rgba(255, 255, 255, 0.14); }
  .s-vol .vol-fill { position: absolute; left: 0; top: 0; bottom: 0; border-radius: 1cqw; background: #f5f5f7; }
  .s-vol .vol-knob { position: absolute; top: 50%; width: 3.6cqw; height: 3.6cqw; margin: -1.8cqw 0 0 -1.8cqw; border-radius: 50%; background: #fff; box-shadow: 0 0.4cqw 1cqw rgba(0, 0, 0, .4); }
  .s-vol .vol-cursor { left: 84%; top: 76.33%; }
  .s-vol .vol-speaker, .s-vol .vol-device { transform-origin: center; }

  .s-vol.playing .vol-cursor { animation: vol-cursor-x var(--d) both, vol-cursor-y var(--d) both; }
  .s-vol.playing .vol-cursor .press { animation: vol-press var(--d) both; }
  .s-vol.playing .vol-music .vol-fill { animation: vol-music-fill var(--d) both; }
  .s-vol.playing .vol-music .vol-knob { animation: vol-music-knob var(--d) both; }
  .s-vol.playing .vol-web .vol-fill { animation: vol-web-fill var(--d) both; }
  .s-vol.playing .vol-web .vol-knob { animation: vol-web-knob var(--d) both; }
  .s-vol.playing .vol-web .vol-speaker { animation: vol-tap var(--d) both; }
  .s-vol.playing .vol-web .vol-on { animation: vol-web-on var(--d) step-end both; }
  .s-vol.playing .vol-web .vol-off { animation: vol-web-off var(--d) step-end both; }
  .s-vol.playing .vol-call .vol-device { animation: vol-device var(--d) both; }
  .s-vol.playing .vol-dev-a { animation: vol-dev-a var(--d) step-end both; }
  .s-vol.playing .vol-dev-b { animation: vol-dev-b var(--d) step-end both; }

  /* Knobs move on the pointer's own x curve while dragged, so they stay under it, and swell a
     little while held. */
  @keyframes vol-music-knob {
    0%, 8% { left: 50%; transform: none; animation-timing-function: cubic-bezier(.3, 0, .1, 1); }
    8.6% { left: 50%; transform: scale(1.2); animation-timing-function: cubic-bezier(.3, 0, .1, 1); }
    16% { left: 85%; transform: scale(1.2); animation-timing-function: cubic-bezier(.34, 1.56, .64, 1); }
    18%, 76% { left: 85%; transform: none; animation-timing-function: cubic-bezier(.3, 0, .1, 1); }
    76.6% { left: 85%; transform: scale(1.2); animation-timing-function: cubic-bezier(.3, 0, .1, 1); }
    84% { left: 50%; transform: scale(1.2); animation-timing-function: cubic-bezier(.34, 1.56, .64, 1); }
    86%, 100% { left: 50%; transform: none; }
  }
  @keyframes vol-music-fill {
    0%, 8.6% { width: 50%; animation-timing-function: cubic-bezier(.3, 0, .1, 1); }
    16%, 76.6% { width: 85%; animation-timing-function: cubic-bezier(.3, 0, .1, 1); }
    84%, 100% { width: 50%; }
  }
  @keyframes vol-web-knob {
    0%, 23% { left: 60%; transform: none; animation-timing-function: cubic-bezier(.3, 0, .1, 1); }
    23.6% { left: 60%; transform: scale(1.2); animation-timing-function: cubic-bezier(.3, 0, .1, 1); }
    31% { left: 25%; transform: scale(1.2); animation-timing-function: cubic-bezier(.34, 1.56, .64, 1); }
    33%, 62% { left: 25%; transform: none; animation-timing-function: cubic-bezier(.3, 0, .1, 1); }
    62.6% { left: 25%; transform: scale(1.2); animation-timing-function: cubic-bezier(.3, 0, .1, 1); }
    70% { left: 60%; transform: scale(1.2); animation-timing-function: cubic-bezier(.34, 1.56, .64, 1); }
    72%, 100% { left: 60%; transform: none; }
  }
  @keyframes vol-web-fill {
    0%, 23.6% { width: 60%; background: #f5f5f7; animation-timing-function: cubic-bezier(.3, 0, .1, 1); }
    31%, 38.6% { width: 25%; background: #f5f5f7; }
    39.6%, 55.6% { width: 25%; background: rgba(245, 245, 247, .3); }
    56.6%, 62.6% { width: 25%; background: #f5f5f7; animation-timing-function: cubic-bezier(.3, 0, .1, 1); }
    70%, 100% { width: 60%; background: #f5f5f7; }
  }
  /* The speaker and the device name jump a little when clicked. */
  @keyframes vol-tap {
    0%, 38.6% { transform: none; } 39.4% { transform: scale(.8); } 40.6% { transform: scale(1.2); } 42%, 55.6% { transform: none; }
    56.4% { transform: scale(.8); } 57.6% { transform: scale(1.2); } 59%, 100% { transform: none; }
  }
  @keyframes vol-device {
    0%, 47% { transform: none; } 47.8% { transform: scale(.9); } 49% { transform: scale(1.08); } 50.5%, 94% { transform: none; }
    94.8% { transform: scale(.9); } 96% { transform: scale(1.08); } 97.5%, 100% { transform: none; }
  }
  @keyframes vol-web-on { 0% { opacity: 1; } 39.4% { opacity: 0; } 56.4% { opacity: 1; } 100% { opacity: 1; } }
  @keyframes vol-web-off { 0% { opacity: 0; } 39.4% { opacity: 1; } 56.4% { opacity: 0; } 100% { opacity: 0; } }
  @keyframes vol-dev-a { 0% { opacity: 1; } 47.8% { opacity: 0; } 94.8% { opacity: 1; } 100% { opacity: 1; } }
  @keyframes vol-dev-b { 0% { opacity: 0; } 47.8% { opacity: 1; } 94.8% { opacity: 0; } 100% { opacity: 0; } }
</style>
<Fragment set:html={`<style>${css}</style>`} />
