---
import { pop, keyPresses, EASE } from "../../lib/motion";
/** A Windows text editor with "Caf" typed. E is held down: the e appears, and after a moment its
    accents pop up over it, numbered. 2 is pressed: é lights up, the menu goes and é takes the
    e's place, so "Café". Then the é goes again, so it loops. */
const { d } = Astro.props;
const accents = ["è", "é", "ê", "ë", "ē", "ė", "ę"];
const typed = 12, menuIn = 27, pick = 50, menuOut = 55, erase = 90;
const css = [
  pop("am-menu", menuIn, menuOut, 0.8),
  keyPresses("am-2", [pick - 1]),
  // E goes down and stays down until after the menu is up.
  `@keyframes am-e-key {
    0%, ${typed - 0.6}% { transform: none; background: var(--key); }
    ${typed}%, ${menuIn + 10}% { transform: translateY(.6cqw) scale(.94); background: var(--key-lit); }
    ${menuIn + 10.8}% { transform: translateY(-.3cqw) scale(1.04); background: var(--key); }
    ${menuIn + 11.8}%, 100% { transform: none; background: var(--key); }
  }`,
  // The letter's room opens as it's typed and closes as the é goes.
  `@keyframes am-slot {
    0%, ${typed}% { max-width: 0; animation-timing-function: ${EASE.snap}; }
    ${typed + 1}%, ${erase}% { max-width: 1em; animation-timing-function: ${EASE.snap}; }
    ${erase + 3}%, 100% { max-width: 0; }
  }`,
  `@keyframes am-e {
    0%, ${typed}% { opacity: 0; transform: scale(.6); animation-timing-function: ${EASE.back}; }
    ${typed + 2}%, ${pick + 1.5}% { opacity: 1; transform: none; }
    ${pick + 2.5}%, 100% { opacity: 0; transform: none; }
  }`,
  `@keyframes am-acute {
    0%, ${pick + 1.5}% { opacity: 0; transform: scale(.6); animation-timing-function: ${EASE.back}; }
    ${pick + 4}%, ${erase}% { opacity: 1; transform: none; animation-timing-function: ${EASE.exit}; }
    ${erase + 2.5}%, 100% { opacity: 0; transform: scale(.6); }
  }`,
  // é is picked: its tile fills with the accent colour, with a little bounce.
  `@keyframes am-pick {
    0%, ${pick}% { background: transparent; color: inherit; transform: none; animation-timing-function: ${EASE.back}; }
    ${pick + 1}% { background: var(--am); color: #1b1b1f; transform: scale(.9); }
    ${pick + 3}%, 100% { background: var(--am); color: #1b1b1f; transform: none; }
  }`,
].join("\n");
---
<div class="spot s-am" style={`--d:${d}s`}>
  <div class="screen am-screen">
    <div class="am-win">
      <div class="am-title">
        <span class="am-app"></span><b></b>
        <svg class="am-ctl" viewBox="0 0 30 10" aria-hidden="true"><path d="M2 5h5M13 2.5h5v5h-5zM24 2.5l5 5M29 2.5l-5 5" fill="none" stroke="currentColor" stroke-width="1"/></svg>
      </div>
      <div class="am-line">
        <span>Caf</span><span class="am-slot"><span class="am-e">e</span><span class="am-acute">é</span>
          <span class="am-menu">
            {accents.map((a, i) => (
              <span class={`am-item${i === 1 ? " am-picked" : ""}`}><span>{a}</span><small>{i + 1}</small></span>
            ))}
          </span>
        </span><span class="am-caret"></span>
      </div>
      <div class="am-lines"><b></b><b></b><b></b></div>
    </div>
  </div>
  <div class="keys"><span class="key am-e-key">E</span><span class="key am-2">2</span></div>
</div>
<Fragment set:html={`<style>${css}</style>`} />

<style is:global>
  /* Windows 11 in dark mode: the bloom wallpaper and one Mica window, a text editor. */
  .s-am { --am: #e58df2; font-family: "Segoe UI Variable Text", "Segoe UI", system-ui, sans-serif; }
  .s-am .am-screen {
    border-radius: 1.4cqw;
    background:
      radial-gradient(60% 70% at 62% 58%, rgba(96, 150, 255, .55), transparent 70%),
      radial-gradient(40% 50% at 40% 70%, rgba(140, 110, 255, .35), transparent 70%),
      linear-gradient(160deg, #18213f, #0d1226);
  }
  .s-am .am-win {
    position: absolute; left: 8%; top: 9%; width: 84%; height: 82%; border-radius: 1cqw; background: #202020;
    box-shadow: 0 0 0 0.18cqw rgba(255, 255, 255, .12), 0 1.6cqw 3.2cqw rgba(0, 0, 0, .5);
  }
  .s-am .am-title { display: flex; align-items: center; gap: 1cqw; height: 4cqw; padding: 0 1.4cqw; background: #2b2b2b; color: rgba(255, 255, 255, .8); border-radius: 1cqw 1cqw 0 0; }
  .s-am .am-app { flex: none; width: 1.8cqw; height: 1.8cqw; border-radius: 0.4cqw; background: var(--am); }
  .s-am .am-title b { flex: none; width: 8cqw; height: 0.9cqw; border-radius: 1cqw; background: rgba(255, 255, 255, .3); }
  .s-am .am-ctl { flex: none; width: 7cqw; margin-left: auto; }

  .s-am .am-line { position: absolute; left: 26%; top: 46%; display: flex; align-items: center; font-size: 7cqw; font-weight: 500; line-height: 1; }
  .s-am .am-slot { position: relative; display: inline-grid; max-width: 0; }
  .s-am .am-e, .s-am .am-acute { grid-area: 1 / 1; opacity: 0; transform-origin: 50% 80%; }
  .s-am .am-caret { width: 0.4cqw; height: 8cqw; margin-left: 0.4cqw; background: #f5f5f7; }

  /* The menu over the letter: glass, each accent with its number under it. */
  .s-am .am-menu {
    position: absolute; left: 50%; bottom: calc(100% + 2.2cqw); margin-left: -21.6cqw; z-index: 5;
    display: flex; gap: 0.4cqw; padding: 0.8cqw; border-radius: 1.6cqw; opacity: 0;
    background: rgba(52, 52, 58, .9); backdrop-filter: blur(2cqw);
    box-shadow: 0 0 0 0.18cqw rgba(255, 255, 255, .12), 0 1.6cqw 3.2cqw rgba(0, 0, 0, .5);
  }
  .s-am .am-item { display: flex; flex-direction: column; align-items: center; justify-content: center; width: 5.6cqw; height: 7.6cqw; border-radius: 1cqw; }
  .s-am .am-item span { font-size: 3.8cqw; line-height: 1.1; }
  .s-am .am-item small { font-size: 1.7cqw; opacity: .7; }

  .s-am .am-lines { position: absolute; left: 6%; right: 6%; top: 70%; display: flex; flex-direction: column; gap: 1.6cqw; }
  .s-am .am-lines b { display: block; height: 1.2cqw; border-radius: 1cqw; background: rgba(255, 255, 255, .12); }
  .s-am .am-lines b:nth-child(1) { width: 86%; }
  .s-am .am-lines b:nth-child(2) { width: 64%; }
  .s-am .am-lines b:nth-child(3) { width: 74%; }

  .s-am.playing .am-slot { animation: am-slot var(--d) both; }
  .s-am.playing .am-e { animation: am-e var(--d) both; }
  .s-am.playing .am-acute { animation: am-acute var(--d) both; }
  .s-am.playing .am-menu { animation: am-menu var(--d) both; }
  .s-am.playing .am-picked { animation: am-pick var(--d) both; }
  .s-am.playing .am-e-key { animation: am-e-key var(--d) both; }
  .s-am.playing .am-2 { animation: am-2 var(--d) both; }
  .s-am.playing .am-caret { animation: am-blink calc(var(--d) / 8) step-end infinite; }
  @keyframes am-blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }
</style>
