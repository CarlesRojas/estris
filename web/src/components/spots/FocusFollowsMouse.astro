---
import Win from "../Win.astro";
import Cursor from "../Cursor.astro";
/** The pointer glides across three windows and back, in a gentle arc; each comes forward, with
    a little bounce, the moment the pointer enters it. The instants come from the path's own
    curve (see FOCUS below): going right it reaches x = 44% (A's edge) and 70% (B's edge),
    coming back 58% (C's edge) and 32% (B's edge). */
const { d } = Astro.props;
// Worked out from cubic-bezier(.45, 0, .55, 1) between x 15 and 85 over 8%–45% and back over
// 55%–92% (solved numerically).
const FOCUS = { b: 24.74, c: 32.86, cBack: 71.14, a: 79.12 };
const raise = (name: string, at: number[]) => `@keyframes ${name} { 0% { transform: none; } ${at.map((p) => `${p}% { transform: none; } ${p + 0.8}% { transform: scale(1.025); } ${p + 2.2}% { transform: none; }`).join(" ")} 100% { transform: none; } }`;
const css = [raise("focus-pop-a", [FOCUS.a]), raise("focus-pop-b", [FOCUS.b, FOCUS.cBack]), raise("focus-pop-c", [FOCUS.c])].join("\n")
  + `
  @keyframes focus-a { 0% { z-index: 3; filter: none; } ${FOCUS.b}% { z-index: 2; filter: brightness(.6); } ${FOCUS.c}% { z-index: 1; filter: brightness(.6); } ${FOCUS.a}% { z-index: 3; filter: none; } 100% { z-index: 3; filter: none; } }
  @keyframes focus-b { 0% { z-index: 2; filter: brightness(.6); } ${FOCUS.b}% { z-index: 3; filter: none; } ${FOCUS.c}% { z-index: 2; filter: brightness(.6); } ${FOCUS.cBack}% { z-index: 3; filter: none; } ${FOCUS.a}% { z-index: 2; filter: brightness(.6); } 100% { z-index: 2; filter: brightness(.6); } }
  @keyframes focus-c { 0% { z-index: 1; filter: brightness(.6); } ${FOCUS.c}% { z-index: 3; filter: none; } ${FOCUS.cBack}% { z-index: 2; filter: brightness(.6); } ${FOCUS.a}% { z-index: 1; filter: brightness(.6); } 100% { z-index: 1; filter: brightness(.6); } }`;
---
<div class="spot s-focus" style={`--d:${d}s`}>
  <div class="screen">
    <Win class="focus-a blue" />
    <Win class="focus-b pink" />
    <Win class="focus-c green" />
    <Cursor class="focus-cursor" />
  </div>
</div>
<Fragment set:html={`<style>${css}</style>`} />

<style is:global>
  .s-focus .focus-a { left: 4%; top: 12%; width: 40%; height: 66%; z-index: 3; }
  .s-focus .focus-b { left: 32%; top: 22%; width: 38%; height: 66%; z-index: 2; filter: brightness(.6); }
  .s-focus .focus-c { left: 58%; top: 10%; width: 38%; height: 66%; z-index: 1; filter: brightness(.6); }
  .s-focus .focus-cursor { left: 15%; top: 58%; }

  .s-focus.playing .focus-a { animation: focus-a var(--d) step-end both, focus-pop-a var(--d) both; }
  .s-focus.playing .focus-b { animation: focus-b var(--d) step-end both, focus-pop-b var(--d) both; }
  .s-focus.playing .focus-c { animation: focus-c var(--d) step-end both, focus-pop-c var(--d) both; }
  .s-focus.playing .focus-cursor { animation: focus-x var(--d) both, focus-y var(--d) both; }

  @keyframes focus-x {
    0%, 8% { left: 15%; animation-timing-function: cubic-bezier(.45, 0, .55, 1); }
    45%, 55% { left: 85%; animation-timing-function: cubic-bezier(.45, 0, .55, 1); }
    92%, 100% { left: 15%; }
  }
  /* A gentle dip going right and a rise coming back: the path is an arc, not a line. */
  @keyframes focus-y {
    0%, 8% { top: 58%; animation-timing-function: cubic-bezier(.37, 0, .63, 1); }
    26.5% { top: 64%; animation-timing-function: cubic-bezier(.37, 0, .63, 1); }
    45%, 55% { top: 56%; animation-timing-function: cubic-bezier(.37, 0, .63, 1); }
    73.5% { top: 50%; animation-timing-function: cubic-bezier(.37, 0, .63, 1); }
    92%, 100% { top: 58%; }
  }
</style>
