---
import Win from "../Win.astro";
import Cursor from "../Cursor.astro";
/** The pointer glides across three windows and back; each comes forward the moment the pointer
    enters it. The path is straight and steady, so the instants are known: going right, x = 44%
    (A's edge) at 23.33% and 70% (B's edge) at 37.07%; coming back, 58% (C's edge) at 69.27%
    and 32% (B's edge) at 83.01%. */
const { d } = Astro.props;
---
<div class="spot s-focus" style={`--d:${d}s`}>
  <div class="screen">
    <Win class="focus-a blue" />
    <Win class="focus-b pink" />
    <Win class="focus-c green" />
    <Cursor class="focus-cursor" />
  </div>
</div>

<style is:global>
  .s-focus .focus-a { left: 4%; top: 12%; width: 40%; height: 66%; z-index: 3; }
  .s-focus .focus-b { left: 32%; top: 22%; width: 38%; height: 66%; z-index: 2; filter: brightness(.6); }
  .s-focus .focus-c { left: 58%; top: 10%; width: 38%; height: 66%; z-index: 1; filter: brightness(.6); }
  .s-focus .focus-cursor { left: 15%; top: 58%; }

  .s-focus.playing .focus-a { animation: focus-a var(--d) step-end both; }
  .s-focus.playing .focus-b { animation: focus-b var(--d) step-end both; }
  .s-focus.playing .focus-c { animation: focus-c var(--d) step-end both; }
  .s-focus.playing .focus-cursor { animation: focus-cursor var(--d) linear both; }

  @keyframes focus-cursor {
    0%, 8% { left: 15%; top: 58%; }
    45%, 55% { left: 85%; top: 58%; }
    92%, 100% { left: 15%; top: 58%; }
  }
  /* Front to back: A B C, then B A C, C B A, B C A, and A B C again. */
  @keyframes focus-a { 0% { z-index: 3; filter: none; } 23.33% { z-index: 2; filter: brightness(.6); } 37.07% { z-index: 1; filter: brightness(.6); } 83.01% { z-index: 3; filter: none; } 100% { z-index: 3; filter: none; } }
  @keyframes focus-b { 0% { z-index: 2; filter: brightness(.6); } 23.33% { z-index: 3; filter: none; } 37.07% { z-index: 2; filter: brightness(.6); } 69.27% { z-index: 3; filter: none; } 83.01% { z-index: 2; filter: brightness(.6); } 100% { z-index: 2; filter: brightness(.6); } }
  @keyframes focus-c { 0% { z-index: 1; filter: brightness(.6); } 37.07% { z-index: 3; filter: none; } 69.27% { z-index: 2; filter: brightness(.6); } 83.01% { z-index: 1; filter: brightness(.6); } 100% { z-index: 1; filter: brightness(.6); } }
</style>
