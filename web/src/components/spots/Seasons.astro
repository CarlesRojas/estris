---
import Cursor from "../Cursor.astro";
import { pointer, presses, EASE } from "../../lib/motion";
/** A window on a dark screen while the seasons go by: snow, then pink petals, sand and autumn
    leaves fall and pile up on the window's top edge and the bottom of the screen. In winter the
    pointer grabs the window and shakes it, and the snow on it falls off. Each season's piles
    melt away as the next one starts, so it loops. */
const { d } = Astro.props;

// Each season's share of the loop, in %, and how its particles look.
const seasons = [
  { id: "winter", name: "Winter", from: 0, to: 34, color: "#f5f7ff", count: 34, size: [0.7, 1.4], shape: "50%", spin: 0, sway: 1.5 },
  { id: "spring", name: "Spring", from: 34, to: 56, color: "#f6b3cc", count: 22, size: [1.2, 1.8], shape: "70% 0", spin: 360, sway: 3 },
  { id: "summer", name: "Summer", from: 56, to: 78, color: "#e3c58f", count: 40, size: [0.45, 0.7], shape: "50%", spin: 0, sway: 0.6 },
  { id: "autumn", name: "Autumn", from: 78, to: 100, color: "#e0892f", count: 16, size: [1.8, 2.6], shape: "0 70%", spin: 540, sway: 4 },
];
const leafColors = ["#e0892f", "#c8552a", "#e8b23a", "#9c5a2c"];

// The same particles on every build.
let seed = 7;
const random = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;

// Each falls in a whole number of loops per `--d`, so the loop ends as it starts.
const particles = seasons.flatMap((season) =>
  Array.from({ length: season.count }, () => {
    const size = season.size[0] + random() * (season.size[1] - season.size[0]);
    const color = season.id === "autumn" ? leafColors[Math.floor(random() * leafColors.length)] : season.color;
    return { season: season.id, left: random() * 100, size, color, falls: 5 + Math.floor(random() * 4), delay: random(), spin: season.spin * (random() < 0.5 ? -1 : 1), sway: season.sway, shape: season.shape };
  }),
);

/** A season's particles show only during it, fading in and out. */
const visible = (s: (typeof seasons)[number]) =>
  s.from === 0
    ? // Snow comes back as autumn ends, so the loop joins up.
      `@keyframes ss-${s.id}-on { 0%, ${s.to - 1}% { opacity: 1; } ${s.to + 1}%, 97% { opacity: 0; } 100% { opacity: 1; } }`
    : `@keyframes ss-${s.id}-on { 0%, ${s.from - 1}% { opacity: 0; } ${s.from + 1}%, ${Math.min(s.to - 1, 97)}% { opacity: 1; } ${Math.min(s.to + 1, 100)}%, 100% { opacity: 0; } }`;

/** A pile that grows over its season and melts as the next starts. Winter's on the window falls
    off when it is shaken instead. */
const pile = (name: string, from: number, full: number, to: number) => `@keyframes ${name} {
  0%, ${from}% { transform: scaleY(0); opacity: 1; }
  ${full}% { transform: scaleY(1); opacity: 1; }
  ${to}% { transform: scaleY(1); opacity: 1; }
  ${Math.min(to + 3, 100)}%, 100% { transform: scaleY(.6); opacity: 0; }
}`;

// The window's bar is at (50%, 32.5%) of the screen; it is shaken from 22 % to 30 %.
const css = [
  pointer("ss-cursor", [[0, 86, 92], [12, 86, 92], [20, 50, 32.5], [22, 50, 32.5], [23, 45, 32.5], [24, 55, 32.5], [25, 45, 32.5], [26, 55, 32.5], [27, 45, 32.5], [28, 55, 32.5], [30, 50, 32.5], [32, 50, 32.5], [42, 86, 92], [100, 86, 92]]),
  presses("ss-press", [], [[21, 30]]),
  `@keyframes ss-shake {
    0%, 22% { transform: none; }
    23% { transform: translateX(-4.4cqw) rotate(-1deg); }
    24% { transform: translateX(4.4cqw) rotate(1deg); }
    25% { transform: translateX(-4.4cqw) rotate(-1deg); }
    26% { transform: translateX(4.4cqw) rotate(1deg); }
    27% { transform: translateX(-4.4cqw) rotate(-1deg); }
    28% { transform: translateX(4.4cqw) rotate(1deg); }
    30%, 100% { transform: none; }
  }`,
  // Shaken off: drops and breaks up.
  `@keyframes ss-top-winter {
    0% { transform: scaleY(0); opacity: 1; }
    18%, 23% { transform: scaleY(1); opacity: 1; animation-timing-function: ${EASE.exit}; }
    27% { transform: translateY(14cqw) scaleY(.7); opacity: 0; }
    100% { transform: scaleY(0); opacity: 0; }
  }`,
  `@keyframes ss-crumbs {
    0%, 23% { opacity: 0; transform: none; animation-timing-function: ${EASE.exit}; }
    24% { opacity: 1; transform: none; animation-timing-function: ${EASE.exit}; }
    31% { opacity: 0; transform: translateY(30cqw); }
    100% { opacity: 0; transform: translateY(30cqw); }
  }`,
  pile("ss-bottom-winter", 2, 30, 34),
  ...seasons.slice(1).flatMap((s) => [pile(`ss-top-${s.id}`, s.from + 1, s.to - 6, s.to - 2), pile(`ss-bottom-${s.id}`, s.from + 1, s.to - 4, s.to - 2)]),
  ...seasons.map(visible),
  ...seasons.map((s) => `@keyframes ss-label-${s.id} {
    0%, ${Math.max(0, s.from - 0.1)}% { opacity: 0; transform: translateY(1.5cqw) scale(.85); }
    ${s.from}% { animation-timing-function: ${EASE.back}; }
    ${s.from + 3}%, ${s.to - 2}% { opacity: 1; transform: none; }
    ${s.to - 2}% { animation-timing-function: ${EASE.exit}; }
    ${s.to}%, 100% { opacity: 0; transform: scale(.94); }
  }`),
  `@keyframes ss-fall { from { transform: translateY(0) rotate(0); } to { transform: translateY(var(--h)) rotate(var(--spin)); } }`,
  `@keyframes ss-sway { 0%, 100% { margin-left: calc(var(--sway) * -1); animation-timing-function: ${EASE.sine}; } 50% { margin-left: var(--sway); animation-timing-function: ${EASE.sine}; } }`,
].join("\n");
---
<div class="spot s-ss" style={`--d:${d}s`}>
  <div class="screen ss-screen">
    {seasons.map((s) => (
      <div class={`ss-flakes ss-flakes-${s.id}`}>
        {particles.filter((p) => p.season === s.id).map((p) => (
          <i style={`left:${p.left.toFixed(2)}%;--s:${p.size.toFixed(2)}cqw;background:${p.color};border-radius:${p.shape};--spin:${p.spin}deg;--sway:${p.sway}cqw;--t:calc(var(--d) / ${p.falls});animation-delay:calc(var(--t) * -${p.delay.toFixed(3)})`}><b></b></i>
        ))}
      </div>
    ))}
    <div class="ss-wrap">
      {seasons.map((s) => <div class={`ss-pile ss-top ss-top-${s.id}`}></div>)}
      <div class="ss-crumbs"><b></b><b></b><b></b><b></b><b></b><b></b></div>
      <div class="win ss-win">
        <div class="bar"><i></i><i></i><i></i></div>
        <div class="ss-lines"><b></b><b></b><b></b></div>
      </div>
    </div>
    {seasons.map((s) => <div class={`ss-pile ss-bottom ss-bottom-${s.id}`}></div>)}
    <Cursor class="ss-cursor" />
  </div>
  <div class="ss-labels">
    {seasons.map((s) => <span class={`pill ss-label ss-label-${s.id}`}>{s.name}</span>)}
  </div>
</div>

<style is:global>
  .s-ss { --winter: #f5f7ff; --spring: #f6b3cc; --summer: #e3c58f; --autumn: #d9782c; }
  .s-ss .ss-flakes { position: absolute; inset: 0; z-index: 3; pointer-events: none; opacity: 0; }
  .s-ss .ss-flakes-winter { opacity: 1; }
  /* Each particle: an outer element that sways, an inner one that falls the screen's height. */
  .s-ss .ss-flakes i {
    position: absolute; top: calc(var(--s) * -2); width: var(--s); height: var(--s); display: block;
    --h: 70cqw; transform: translateY(0);
  }
  .s-ss .ss-flakes i b { display: none; }
  .s-ss .ss-wrap { position: absolute; left: 18%; top: 30%; width: 64%; height: 46%; z-index: 2; }
  .s-ss .ss-win { inset: 0; }
  .s-ss .ss-lines { position: absolute; left: 8%; right: 8%; top: 22%; display: flex; flex-direction: column; gap: 1.4cqw; }
  .s-ss .ss-lines b { display: block; height: 1.3cqw; border-radius: 1cqw; background: rgba(255, 255, 255, .1); }
  .s-ss .ss-lines b:first-child { width: 45%; background: #8fb8ff; }
  .s-ss .ss-lines b:nth-child(2) { width: 70%; }
  .s-ss .ss-lines b:last-child { width: 55%; }
  /* Piles: a mound with soft ends, growing up from where it rests. */
  .s-ss .ss-pile { position: absolute; transform-origin: bottom; transform: scaleY(0); border-radius: 50% 50% 0 0 / 100% 100% 0 0; }
  .s-ss .ss-top { left: 1%; right: 1%; bottom: 100%; height: 2.4cqw; margin-bottom: -0.3cqw; }
  .s-ss .ss-bottom { left: -3%; right: -3%; bottom: 0; height: 4.6cqw; z-index: 4; border-radius: 40% 60% 0 0 / 100% 100% 0 0; }
  .s-ss .ss-top-winter, .s-ss .ss-bottom-winter { background: var(--winter); box-shadow: inset 0 -0.4cqw 0.6cqw rgba(140, 160, 200, .35); }
  .s-ss .ss-top-spring, .s-ss .ss-bottom-spring { background: radial-gradient(circle at 30% 40%, #fbd9e6 0 20%, transparent 21%) 0 0 / 2cqw 2cqw, var(--spring); }
  .s-ss .ss-top-summer, .s-ss .ss-bottom-summer { background: radial-gradient(circle, rgba(150, 110, 60, .35) 0 18%, transparent 20%) 0 0 / 0.8cqw 0.8cqw, var(--summer); }
  .s-ss .ss-top-autumn, .s-ss .ss-bottom-autumn { background: radial-gradient(circle at 40% 50%, #c8552a 0 24%, transparent 26%) 0 0 / 2.4cqw 1.6cqw, radial-gradient(circle at 70% 30%, #e8b23a 0 22%, transparent 24%) 0 0 / 3cqw 2cqw, var(--autumn); }
  .s-ss .ss-crumbs { position: absolute; left: 0; right: 0; bottom: 100%; height: 2cqw; opacity: 0; }
  .s-ss .ss-crumbs b { position: absolute; bottom: 0; width: 1.6cqw; height: 1.2cqw; border-radius: 50%; background: var(--winter); }
  .s-ss .ss-crumbs b:nth-child(1) { left: 6%; } .s-ss .ss-crumbs b:nth-child(2) { left: 22%; margin-bottom: 2cqw; }
  .s-ss .ss-crumbs b:nth-child(3) { left: 40%; } .s-ss .ss-crumbs b:nth-child(4) { left: 58%; margin-bottom: 3cqw; }
  .s-ss .ss-crumbs b:nth-child(5) { left: 76%; } .s-ss .ss-crumbs b:nth-child(6) { left: 92%; margin-bottom: 1cqw; }
  .s-ss .ss-cursor { left: 86%; top: 92%; z-index: 6; }
  .s-ss .ss-labels { position: absolute; left: 0; right: 0; top: 79%; display: grid; justify-items: center; }
  .s-ss .ss-label { grid-area: 1 / 1; opacity: 0; font-size: 3.4cqw; padding: 1.6cqw 3cqw; }

  .s-ss.playing .ss-flakes i { animation: ss-fall var(--t) linear infinite, ss-sway calc(var(--t) / 2) infinite; }
  .s-ss.playing .ss-cursor { animation: ss-cursor-x var(--d) both, ss-cursor-y var(--d) both; }
  .s-ss.playing .ss-cursor .press { animation: ss-press var(--d) both; }
  .s-ss.playing .ss-wrap { animation: ss-shake var(--d) both; }
  .s-ss.playing .ss-crumbs { animation: ss-crumbs var(--d) both; }
  .s-ss.playing .ss-top-winter { animation: ss-top-winter var(--d) both; }
  .s-ss.playing .ss-bottom-winter { animation: ss-bottom-winter var(--d) both; }
  .s-ss.playing .ss-top-spring { animation: ss-top-spring var(--d) both; }
  .s-ss.playing .ss-bottom-spring { animation: ss-bottom-spring var(--d) both; }
  .s-ss.playing .ss-top-summer { animation: ss-top-summer var(--d) both; }
  .s-ss.playing .ss-bottom-summer { animation: ss-bottom-summer var(--d) both; }
  .s-ss.playing .ss-top-autumn { animation: ss-top-autumn var(--d) both; }
  .s-ss.playing .ss-bottom-autumn { animation: ss-bottom-autumn var(--d) both; }
  .s-ss.playing .ss-flakes-winter { animation: ss-winter-on var(--d) both; }
  .s-ss.playing .ss-flakes-spring { animation: ss-spring-on var(--d) both; }
  .s-ss.playing .ss-flakes-summer { animation: ss-summer-on var(--d) both; }
  .s-ss.playing .ss-flakes-autumn { animation: ss-autumn-on var(--d) both; }
  .s-ss.playing .ss-label-winter { animation: ss-label-winter var(--d) both; }
  .s-ss.playing .ss-label-spring { animation: ss-label-spring var(--d) both; }
  .s-ss.playing .ss-label-summer { animation: ss-label-summer var(--d) both; }
  .s-ss.playing .ss-label-autumn { animation: ss-label-autumn var(--d) both; }
</style>
<Fragment set:html={`<style>${css}</style>`} />
